# 本地服务
LAND_PORT=4399
# LAND_DATA_DIR=./data
# 浏览器扩展跨域白名单：逗号分隔的 Chrome 扩展 ID，默认空＝关闭
# LAND_EXTENSION_ORIGINS=abcdefghijklmnopabcdefghijklmnop

# 公开岗位库（Position Hub）；由 land-a-job 服务端代理，token 不下发到浏览器
# POSITION_HUB_BASE_URL=http://127.0.0.1:4400
# POSITION_HUB_TOKEN=replace-with-position-hub-token

# 说明：按 PRD D2「应用零模型调用」，此处不提供任何模型 / API Key 配置。
# AI 能力由用户安装的 Skill 在其 Agent 中执行，本应用不代理模型请求。
