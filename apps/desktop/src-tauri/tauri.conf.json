{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Land a Job",
  "version": "0.2.2",
  "identifier": "com.dada.liu.land-a-job",
  "build": {
    "frontendDist": "../resources/app/apps/web/dist",
    "devUrl": "http://127.0.0.1:4399"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/land-server"],
    "resources": {
      "../resources/app": "app"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
